# Easiest: `deploy/init-env.sh <hostname>` creates .env.prod from this file with random secrets.
# By hand: copy to .env.prod and fill in. It is read by `docker compose --env-file .env.prod`.

# The hostname Caddy serves (DNS must point at this machine) and its https origin.
SITE_ADDRESS=ticketrush-yash.duckdns.org
PUBLIC_URL=https://ticketrush-yash.duckdns.org

# Generate each with: openssl rand -hex 24   (hex only: the Postgres one goes inside a URL)
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Password for the demo admin created by the seed (admin@ticketrush.dev). Pick your own.
SEED_ADMIN_PASSWORD=

# Share of mock payments that fail on purpose, to exercise the retry path.
MOCK_PAYMENT_FAILURE_RATE=0.1

# Only for running the stack on your own machine (SITE_ADDRESS=:80): the host port Caddy listens on.
# HTTP_PORT=8080
